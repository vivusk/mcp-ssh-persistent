{
  "name": "mcp-ssh-persistent",
  "version": "2.0.0",
  "description": "MCP Server for persistent SSH connections with streaming support",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mcp-ssh-persistent": "src/index.js",
    "mcp-ssh-persistent-set-sudo-password": "scripts/set-sudo-password.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node scripts/smoke-test.js",
    "smoke:mcp": "node scripts/mcp-stdio-smoke.js",
    "set-sudo-password": "node scripts/set-sudo-password.js"
  },
  "keywords": [
    "mcp",
    "ssh",
    "claude",
    "model-context-protocol",
    "persistent",
    "streaming",
    "sftp",
    "claude-code"
  ],
  "author": "Duy Pham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivusk/mcp-ssh-persistent.git"
  },
  "homepage": "https://github.com/vivusk/mcp-ssh-persistent#readme",
  "bugs": {
    "url": "https://github.com/vivusk/mcp-ssh-persistent/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "scripts/set-sudo-password.js",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/keyring": "^2.1.2",
    "ssh2": "^1.16.0"
  }
}
